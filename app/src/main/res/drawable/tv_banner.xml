<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#102D3B" android:endColor="#071017" />
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#16453F" />
            <stroke android:width="2dp" android:color="#41D6B3" />
        </shape>
    </item>
</layer-list>
